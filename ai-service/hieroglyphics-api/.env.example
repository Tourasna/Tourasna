# =============================================================================
# Tourasna Hieroglyphics Translator API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host to bind the server to (use 0.0.0.0 to accept external connections)
HOST=0.0.0.0

# Port to listen on
PORT=8000

# Enable debug mode (verbose logging, auto-reload on code changes)
# Set to "true" only in development. Use "false" in production.
DEBUG=false


# -----------------------------------------------------------------------------
# Compute Device
# -----------------------------------------------------------------------------
# Where to run the ML models:
#   - "auto" : Use CUDA if available, otherwise CPU (recommended)
#   - "cuda" : Force GPU (must have NVIDIA GPU + CUDA installed)
#   - "cpu"  : Force CPU (slower but works everywhere)
DEVICE=auto


# -----------------------------------------------------------------------------
# LLM Translator (Layer 2)
# -----------------------------------------------------------------------------
# Groq Cloud API key for LLM-based translation.
# Get a free key at: https://console.groq.com/keys
#
# - If set:    Layer 2 is enabled (high-quality bilingual translations)
# - If empty:  Layer 2 is skipped, falls through to Transformer (Layer 3)
#
# The system works without this key, but quality is significantly lower.
GROQ_API_KEY=

# LLM model identifier (default: llama-3.3-70b-versatile)
# Other options: mixtral-8x7b-32768, llama-3.1-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# Lower values are recommended for translation accuracy.
LLM_TEMPERATURE=0.2

# Max tokens in LLM response
LLM_MAX_TOKENS=1024


# -----------------------------------------------------------------------------
# Detector Settings (YOLOv8)
# -----------------------------------------------------------------------------
# Minimum confidence threshold to keep a detection (0.0 - 1.0)
# Higher = fewer detections, higher quality
# Lower = more detections, more noise
DETECTOR_CONF_THRESHOLD=0.40

# IoU threshold for Non-Maximum Suppression
DETECTOR_IOU_THRESHOLD=0.45

# Below this confidence, a detection is marked as "ambiguous"
# and the API will return top-K alternatives for the user to pick from.
AMBIGUITY_THRESHOLD=0.60

# Number of alternatives to return for ambiguous detections
AMBIGUITY_TOP_K=3


# -----------------------------------------------------------------------------
# Image Upload Limits
# -----------------------------------------------------------------------------
# Maximum image upload size in megabytes
MAX_IMAGE_SIZE_MB=10